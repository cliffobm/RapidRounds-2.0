{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rapidrounds.local/cjis/question.v2.schema.json",
  "title": "RapidRounds CJIS v2 authoring question",
  "description": "Original formative nursing item. difficulty_score is an unvalidated editorial load score; it is not empirical difficulty, point-biserial discrimination or a competence estimate. Semantic and clinical review remain required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "collection_id",
    "topic",
    "clinical_domain",
    "reasoning_level",
    "difficulty_score",
    "difficulty_kind",
    "learner_context",
    "scenario",
    "key_cues",
    "question",
    "options",
    "correct_answer",
    "rationale",
    "distractor_analysis",
    "debrief",
    "reasoning_evidence",
    "distractor_evidence",
    "references",
    "review_status",
    "clinical_review",
    "calibration_status"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "id": { "type": "string", "pattern": "^v2-[a-z0-9-]+$" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 80 },
    "collection_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "topic": { "$ref": "#/$defs/text" },
    "clinical_domain": {
      "enum": [
        "cardiovascular",
        "respiratory",
        "neurologic",
        "renal",
        "endocrine_metabolic",
        "sepsis_infectious",
        "multisystem",
        "pharmacology",
        "fundamentals",
        "person_centered"
      ]
    },
    "reasoning_level": { "enum": ["foundation", "challenge", "advanced"] },
    "primary_competency": {
      "enum": [
        "recognize_cues",
        "analyze_cues",
        "prioritize_hypotheses",
        "generate_solutions",
        "take_action",
        "evaluate_outcomes"
      ]
    },
    "difficulty_score": { "type": "number", "minimum": 0.3, "maximum": 1.3 },
    "difficulty_kind": { "const": "editorial_load_not_calibrated" },
    "learner_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "audience"],
      "properties": {
        "setting": { "$ref": "#/$defs/text" },
        "audience": { "$ref": "#/$defs/text" }
      }
    },
    "scenario": { "$ref": "#/$defs/text" },
    "key_cues": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" },
      "description": "Decision-relevant cue units, indexed C1 through Cn in this exact revision. Keep hidden until debrief when cue recognition is being assessed."
    },
    "question": { "$ref": "#/$defs/text" },
    "options": { "$ref": "#/$defs/optionTexts" },
    "correct_answer": { "$ref": "#/$defs/optionId" },
    "rationale": { "$ref": "#/$defs/text" },
    "distractor_analysis": { "$ref": "#/$defs/optionTexts" },
    "debrief": { "$ref": "#/$defs/text" },
    "reasoning_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_load",
        "distractor_demand",
        "operations",
        "decisive_cue_ids",
        "single_best_justification"
      ],
      "properties": {
        "cue_load": { "enum": ["sparse", "moderate", "layered"] },
        "distractor_demand": {
          "enum": ["plausible", "inference", "multistep"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/text" }
        },
        "decisive_cue_ids": { "$ref": "#/$defs/cueLinks" },
        "single_best_justification": { "$ref": "#/$defs/text" },
        "conflicting_evidence": { "$ref": "#/$defs/text" },
        "anticipation": { "$ref": "#/$defs/text" },
        "uncertainty": { "$ref": "#/$defs/text" }
      }
    },
    "distractor_evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "intended_error",
          "why_plausible",
          "why_not_best",
          "cue_ids"
        ],
        "properties": {
          "option_id": { "$ref": "#/$defs/optionId" },
          "intended_error": {
            "enum": [
              "misprioritization",
              "cue_misinterpretation",
              "premature_closure",
              "outdated_data"
            ]
          },
          "why_plausible": { "$ref": "#/$defs/text" },
          "why_not_best": { "$ref": "#/$defs/text" },
          "cue_ids": { "$ref": "#/$defs/cueLinks" }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[^\\s]+$" }
    },
    "review_status": { "enum": ["draft", "clinical_review", "approved"] },
    "clinical_review": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer_id", "reviewed_at", "approved_revision"],
          "properties": {
            "reviewer_id": { "$ref": "#/$defs/text" },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            },
            "approved_revision": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "calibration_status": { "const": "uncalibrated" }
  },
  "allOf": [
    {
      "if": { "properties": { "reasoning_level": { "const": "foundation" } } },
      "then": {
        "properties": { "key_cues": { "type": "array", "maxItems": 3 } }
      }
    },
    {
      "if": { "properties": { "reasoning_level": { "const": "challenge" } } },
      "then": {
        "properties": {
          "key_cues": { "type": "array", "minItems": 3, "maxItems": 5 },
          "reasoning_evidence": {
            "type": "object",
            "properties": { "operations": { "type": "array", "minItems": 2 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "reasoning_level": { "const": "advanced" } } },
      "then": {
        "properties": {
          "key_cues": { "type": "array", "minItems": 5 },
          "reasoning_evidence": {
            "type": "object",
            "required": ["conflicting_evidence", "anticipation", "uncertainty"],
            "properties": { "operations": { "type": "array", "minItems": 2 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "review_status": { "const": "approved" } } },
      "then": {
        "properties": { "clinical_review": { "not": { "type": "null" } } }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 8,
      "maxLength": 6000,
      "pattern": "\\S"
    },
    "optionId": { "enum": ["A", "B", "C", "D"] },
    "cueLinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^C[1-7]$" }
    },
    "optionTexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "$ref": "#/$defs/text" },
        "B": { "$ref": "#/$defs/text" },
        "C": { "$ref": "#/$defs/text" },
        "D": { "$ref": "#/$defs/text" }
      }
    }
  }
}
