import React,{useState} from 'react';
import {Pressable,Text,TextInput,View} from 'react-native';
import {useStyles} from '../styles';
import {authProviders,isAuthConfigured,requestPasswordReset,signInEmail,signInProvider,signOut,signUpEmail,updatePassword,useAuthSession} from '../lib/auth';
import {normalizeUsername,validUsername} from '../lib/profile';
import {Button,SectionTitle} from './ui';
export interface AuthScreenProps {onClose:()=>void;onAuthenticated?:()=>void}
export function AuthScreen({onClose,onAuthenticated}:AuthScreenProps){
  const s=useStyles();const auth=useAuthSession();const [mode,setMode]=useState<'signin'|'signup'|'reset'>('signin');const [email,setEmail]=useState('');const [password,setPassword]=useState('');const [confirm,setConfirm]=useState('');const [username,setUsername]=useState('');const [busy,setBusy]=useState(false);const [notice,setNotice]=useState('');
  const configured=isAuthConfigured&&!auth.loading;const disabled=busy||!configured;
  async function submit(){setBusy(true);setNotice('');try{
    if(auth.recovery){if(password.length<8||password.length>128)throw new Error('Choose a password between 8 and 128 characters.');if(password!==confirm)throw new Error('Passwords do not match.');await updatePassword(password);setPassword('');setConfirm('');setNotice('Password updated. You are signed in.');return;}
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim()))throw new Error('Enter a valid email address. Use email to sign in; your study handle is separate.');
    if(mode==='reset'){await requestPasswordReset(email);setNotice('If an eligible account uses this email, a reset link will arrive. Open it on the same device and browser that requested it.');return;}
    if(!password||password.length>128)throw new Error('Enter your password (up to 128 characters).');
    if(mode==='signup'){
      if(password.length<8)throw new Error('Choose a password of at least 8 characters.');if(password!==confirm)throw new Error('Passwords do not match.');if(!validUsername(normalizeUsername(username)))throw new Error('Use 3–24 lowercase letters, numbers, or underscores for your optional handle.');
      const session=await signUpEmail(email,password,normalizeUsername(username));setPassword('');setConfirm('');if(session){setNotice('Account created and signed in.');onAuthenticated?.();}else setNotice('Check your email to confirm your account. No sign-in session has been created yet. Open the link on this device.');
    }else{const session=await signInEmail(email,password);setPassword('');if(session){setNotice('Signed in. Your study data still belongs to this device.');onAuthenticated?.();}}
  }catch(error){setNotice(error instanceof Error?error.message:'Sign-in could not be completed.');}finally{setBusy(false);}}
  async function provider(name:'google'|'apple'){setBusy(true);setNotice('');try{await signInProvider(name);}catch(error){setNotice(error instanceof Error?error.message:'Provider sign-in failed.');}finally{setBusy(false);}}
  const input=(label:string,value:string,setter:(value:string)=>void,secret=false)=><View style={s.stack}><Text style={s.heading}>{label}</Text><TextInput accessibilityLabel={label} value={value} onChangeText={setter} editable={!disabled} secureTextEntry={secret} autoCapitalize="none" autoCorrect={false} keyboardType={label==='Email'?'email-address':'default'} textContentType={label==='Email'?'emailAddress':secret?'password':'username'} maxLength={secret?128:label==='Study handle (optional)'?24:254} style={[s.field,{minHeight:54}]}/></View>;
  return <View style={s.stack}><SectionTitle eyebrow="OPTIONAL ACCOUNT" title={auth.recovery?'Choose a new password':auth.session?'Your account':mode==='signup'?'Create your account':mode==='reset'?'Reset your password':'Welcome back'} body="Guest study stays available. Signing in does not yet sync your profile, photo, or study progress."/>
    {!isAuthConfigured&&<View style={s.card}><Text style={s.heading}>Account setup is still required</Text><Text style={s.body}>This preview has no configured account service. Email, Google, and Apple sign-in are unavailable until the app owner connects and verifies them.</Text><Button title="Continue as guest" onPress={onClose}/></View>}
    {auth.session&&!auth.recovery?<View style={s.card}><Text style={s.heading}>Signed in</Text><Text style={s.body}>{auth.session.user.email??'Connected account'}</Text><Text style={s.caption}>Your local study profile is separate from account metadata. Signing out keeps local study data on this device.</Text><Button title={busy?'Signing out…':'Sign out on this device'} disabled={busy} secondary onPress={()=>{setBusy(true);void signOut().then(()=>setNotice('Signed out on this device.')).catch(error=>setNotice(error instanceof Error?error.message:'Sign-out failed.')).finally(()=>setBusy(false));}}/></View>:<>
      {!auth.recovery&&<View style={s.row}>{(['signin','signup'] as const).map(m=><Pressable key={m} accessibilityRole="radio" accessibilityState={{checked:mode===m,disabled:busy}} disabled={busy} style={[s.choice,mode===m&&s.selected]} onPress={()=>{setMode(m);setNotice('');setPassword('');setConfirm('');}}><Text style={s.optionText}>{m==='signin'?'Sign in':'Create account'}</Text></Pressable>)}</View>}
      <View style={s.card}>{!auth.recovery&&input('Email',email,setEmail)}{mode==='signup'&&!auth.recovery&&<>{input('Study handle (optional)',username,value=>setUsername(normalizeUsername(value)))}<Text style={s.caption}>Your handle is profile metadata, not a unique reserved username. Sign in with email; the app does not look up or expose account emails by handle.</Text></>}{(mode!=='reset'||auth.recovery)&&input(auth.recovery?'New password':'Password',password,setPassword,true)}{(mode==='signup'||auth.recovery)&&input('Confirm password',confirm,setConfirm,true)}<Button title={busy?'Please wait…':auth.recovery?'Save new password':mode==='signup'?'Create account':mode==='reset'?'Send reset link':'Sign in with email'} disabled={disabled} onPress={()=>void submit()}/>{mode!=='signup'&&!auth.recovery&&<Button title={mode==='reset'?'Back to sign in':'Forgot password?'} secondary disabled={busy} onPress={()=>{setMode(mode==='reset'?'signin':'reset');setNotice('');setPassword('');setConfirm('');}}/>}</View>
      {!auth.recovery&&<View style={s.card}><Text style={s.heading}>Or use a connected provider</Text><Button title={authProviders.google?'Continue with Google':'Google · Setup required'} secondary disabled={busy||!authProviders.google} onPress={()=>void provider('google')}/><Button title={authProviders.apple?'Continue with Apple':'Apple · Setup required'} secondary disabled={busy||!authProviders.apple} onPress={()=>void provider('apple')}/></View>}
    </>}
    {(notice||auth.error)&&<Text accessibilityRole="alert" style={s.notice}>{notice||auth.error}</Text>}
    <Button title={auth.session?'Back to study':'Continue without signing in'} secondary disabled={busy} onPress={onClose}/>
  </View>;
}
