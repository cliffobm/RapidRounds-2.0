# Enable existing unreviewed seed questions only for local/internal testing.
EXPO_PUBLIC_CONTENT_PREVIEW=true

# Optional account service. Leave blank to keep guest-only mode.
# Only use a publishable/anon client key; never a secret or service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false

# Optional public project identifier. Prefer EAS init writing extra.eas.projectId
# into app.json. Never use an organization ID here.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional monitoring. These are public ingestion keys; no management tokens.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
