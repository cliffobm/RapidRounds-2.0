# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Enable only after configuring Google in Supabase Authentication > Providers.
# Google client ID and secret belong in Supabase, not the application environment.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=your_google_site_verification_code

# CJIS staging endpoint is disabled by default and blocked in production.
CJIS_PREVIEW_ENABLED=false
